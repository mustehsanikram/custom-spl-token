# Network: devnet | testnet | mainnet-beta | localnet
SOLANA_NETWORK=devnet

# Optional custom RPC. Leave blank to use the public endpoint for SOLANA_NETWORK.
SOLANA_RPC_URL=

# Path to the fee-payer / authority keypair JSON (array-of-bytes format).
# Generate one with: npm run dev -- (see README). Never commit this file.
AUTHORITY_KEYPAIR_PATH=./keypairs/authority.json

# Token parameters
TOKEN_NAME=
TOKEN_SYMBOL=
TOKEN_DECIMALS=9
TOKEN_TOTAL_SUPPLY=1000000

# Transfer fee in basis points. 100 = 1.00%, 200 = 2.00%.
TRANSFER_FEE_BASIS_POINTS=100
# Absolute per-transfer fee cap, in whole tokens. Set high so the bps rate governs.
TRANSFER_FEE_MAX_TOKENS=1000000

# Treasury that receives harvested fees and funds cashback payouts.
TREASURY_ADDRESS=
